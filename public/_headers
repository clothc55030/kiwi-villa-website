# Cloudflare Pages Security Headers
# 所有路徑的安全標頭設定

/*
  # 內容安全政策 - 防止 XSS 攻擊
  # 2026-11：拿掉 'unsafe-eval'（評價頁 Elfsight 不需要，11/07 實測）、cdnjs（Font Awesome 改內嵌 SVG）、frame-src 的 Google 地圖（位置頁已不嵌入）
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://static.cloudflareinsights.com https://static.elfsight.com https://*.elfsightcdn.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://static.elfsight.com https://*.elfsightcdn.com; font-src 'self' data: https://fonts.gstatic.com https://*.elfsightcdn.com; img-src 'self' data: https: blob:; connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://*.google.com https://*.google.com.tw https://*.g.doubleclick.net https://cloudflareinsights.com https://*.elfsight.com https://*.elfsightcdn.com; frame-src 'self' https://*.elfsight.com https://*.elfsightcdn.com https://www.youtube-nocookie.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
  
  # 防止點擊劫持
  X-Frame-Options: DENY
  
  # 防止 MIME 類型嗅探
  X-Content-Type-Options: nosniff

  # 強制使用 HTTPS（實際送出的是 Cloudflare 區域設定的 HSTS：180 天、includeSubDomains、preload，這裡寫成一樣，免得誤會）
  Strict-Transport-Security: max-age=15552000; includeSubDomains; preload
  
  # 控制 Referrer 資訊
  Referrer-Policy: strict-origin-when-cross-origin
  
  # 限制瀏覽器功能
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()


# 快取設定
# 注意：Cloudflare Pages 會把「多條規則都命中的同名標頭」用逗號串起來，
# 所以 Cache-Control 不放在 /*，每個路徑只會命中下面其中一條。

# 網頁（乾淨網址）：1 小時
/
  Cache-Control: public, max-age=3600, must-revalidate

/intro
  Cache-Control: public, max-age=3600, must-revalidate

/rooms
  Cache-Control: public, max-age=3600, must-revalidate

/location
  Cache-Control: public, max-age=3600, must-revalidate

/reviews
  Cache-Control: public, max-age=3600, must-revalidate

/faq
  Cache-Control: public, max-age=3600, must-revalidate

/policy
  Cache-Control: public, max-age=3600, must-revalidate

/moses
  Cache-Control: public, max-age=3600, must-revalidate

# 住客工具頁（萬泰名產代訂，noindex）
/wantai
  Cache-Control: public, max-age=3600, must-revalidate

# 靜態資源：一年 immutable（內容有變就換檔名或加版本參數）
/js/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# pages.dev 備用網址與預覽網址不給搜尋引擎收錄（正式網址是 www.kiwi-villa.com）
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
